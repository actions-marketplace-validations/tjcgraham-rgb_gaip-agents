    "/"
   ],
   "expected": [
    "https://example.com/l.xml"
   ]
  },
  {
   "function": "rsl_from_html",
   "name": "plain licence link ignored",
   "args": [
    "<link rel='license' href='https://creativecommons.org/licenses/by/4.0/'>",
