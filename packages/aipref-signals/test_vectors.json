    "/"
   ],
   "expected": []
  },
  {
   "function": "tdmrep_facts",
   "name": "site reserved with policy",
   "args": [
    200,
    "[{\"location\": \"/\", \"tdm-reservation\": 1, \"tdm-policy\": \"https://example.com/policy.json\"}]"
   ],
   "expected": {
    "s": 200,
    "p": 1,
    "rules": 1,
    "site_reserved": true,
    "any_reserved": true,
    "policy_hosts": [
     "example.com"
    ]
   }
  },
  {
   "function": "tdmrep_facts",
   "name": "part of the site reserved",
   "args": [
    200,
    "[{\"location\": \"/images/*\", \"tdm-reservation\": 1}, {\"location\": \"/blog\", \"tdm-reservation\": 0}]"
   ],
   "expected": {
    "s": 200,
    "p": 1,
    "rules": 2,
    "site_reserved": null,
    "any_reserved": true,
    "policy_hosts": []
   }
  },
  {
   "function": "tdmrep_facts",
   "name": "string reservation value",
