  "example_calls": {
    "mcp_check": {
      "url": "https://www.gaipagents.com/mcp",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "gaip_check",
          "arguments": {
            "url": "https://agent.example/.well-known/agent-card.json"
          }
        }
      }
    },
    "mcp_quickstart": {
      "url": "https://www.gaipagents.com/mcp",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "gaip_quickstart",
          "arguments": {}
        }
      }
    },
    "a2a_text": {
      "url": "https://www.gaipagents.com/a2a/agentverse",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "message/send",
        "params": {
          "message": {
            "kind": "message",
            "role": "user",
            "messageId": "m1",
            "parts": [
              {
                "kind": "text",
                "text": "check https://agent.example/.well-known/agent-card.json"
              }
            ]
          }
        }
      }
    },
    "observatory_lookup": "https://www.gaipagents.com/v1/free/observatory/lookup?url=https://agent.example/.well-known/agent-card.json"
  },
