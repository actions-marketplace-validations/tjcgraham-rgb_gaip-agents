{
  "schema_version": "gaip.listing-kit.v1",
  "name": "GAIP",
  "full_name": "GAIP — Governed Agentic Intelligence Platform",
  "website": "https://www.gaipagents.com",
  "logo": {
    "url": "https://www.gaipagents.com/erc8004/images/gaip.svg",
    "mimeType": "image/svg+xml"
  },
  "one_liner": "Free, read-only evidence on AI agents and MCP servers: conformance, change, delivery, receipts.",
  "short_description": "GAIP checks the public declarations of AI agents and MCP servers, watches them for change, witnesses what a delegated call returned and keeps verifiable receipts. Free, read-only, no account.",
  "long_description": "GAIP gives builders and their agents read-only evidence about other agents before and after a delegated call. It is organised as four products plus a provenance showcase over ten public specialist agents. Agent Observatory & Conformance checks A2A, MCP and OpenAPI declarations and handshakes and keeps a hash-chained log of published manifest changes. Supplier Reliability watches the suppliers you depend on for material change and diagnoses failed calls with a bounded repair plan. Delivery Assurance records the checks a buyer expects, witnesses what came back and checks that cited pages contain the quoted text. Evidence Ledger verifies retained receipts, compiles evidence packs and incident bundles, and exports receipts in other ecosystems' shapes. Every result states what was observed and when; it is not a certification, endorsement, ranking or universal score, and not legal, financial or insurance advice. Calls are free and need no account or key; public or non-personal data only.",
  "categories": [
    "developer-tools",
    "agent-infrastructure",
    "interoperability",
    "monitoring",
    "evidence-and-audit"
  ],
  "tags": [
    "mcp",
    "a2a",
    "openapi",
