  "access": {
    "account_required": false,
    "api_key_required": false,
    "cost": "free",
    "data": "public or non-personal only",
    "authority": "read-only"
  },
  "front_door_tools": [
    {
      "name": "gaip_check",
      "title": "Check an AI agent, MCP server or API",
      "use_when": "Use this when asked whether an AI agent, MCP server or API works, is reachable, is valid or has changed. Pass its `url`. Returns a one-line verdict (READY, FIXES_NEEDED, NO_AGENT_CARD or UNREACHABLE), fixes, dated history when GAIP observes it, and a receipt.",
      "example_arguments": {
        "url": "https://www.gaipagents.com/.well-known/agent-card.json"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "gaip_watch",
      "title": "Watch an agent or MCP server for changes",
      "use_when": "Use this when asked to keep an eye on an agent or MCP server, or to be alerted when it changes. Pass its `url` for no-account feed links and its latest dated changes; add `webhook_url` to register a free watch (checked every 24 h, signed webhook on change).",
      "example_arguments": {
        "url": "https://www.gaipagents.com/mcp"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "gaip_diagnose",
      "title": "Why did my agent or API call fail?",
      "use_when": "Use this when an agent, MCP or API call failed and you are asked why or how to fix it. Pass the `error` text and/or `http_status`; add the service `url` to see changes GAIP observed around then. Returns the likely cause, when to retry, fix steps and a receipt.",
      "example_arguments": {
        "error": "HTTP 429 Too Many Requests; Retry-After: 20",
        "http_status": 429
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "gaip_verify",
      "title": "Verify claims, citations or a delivery",
      "use_when": "Use this when asked whether something delivered what was promised, whether claims are true, or whether citations are accurate. Pass `citations`, or `claims` (+ `url`), or a service `url` plus the `result` you got. Returns which check ran and each result.",
      "example_arguments": {
        "citations": [
          {
            "url": "https://www.gaipagents.com/",
            "quote": "GAIP"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    }
  ],
